index 0000000..b50e5bf
--- /dev/null
+++ b/internal/fhirworker/examples.go
@@ -0,0 +1,171 @@
+// Copyright 2026 Query Farm LLC - https://query.farm
+
+package fhirworker
+
+import (
+	"bytes"
+	"encoding/json"
+
+	"github.com/Query-farm/vgi-go/vgi"
+)
+
+// Composed examples: queries that combine two or more of this worker's table
+// functions the way a real user would (one function supplies the patient, the
+// other the clinical rows, joined on the FHIR subject reference). Table
+// functions here only accept literal arguments (no LATERAL / subquery args), so
+// each side is a filtered search pinned to ExamplePatientID and the two are
+// joined on `subject = 'Patient/' || id`.
+//
+// Each SQL is defined ONCE here and referenced from the driving function's
+// Examples (and its vgi.example_queries tag, generated by ExampleQueriesJSON)
+// and from the schema-level list in cmd/vgi-fhir-worker/main.go. Every example
+// targets the frozen SMART Health IT sandbox (see ExampleBaseURL), so the rows
+// quoted in the descriptions stay true.
+
+// ExampleWeightTrend joins fhir_observations to fhir_patients: one patient's
+// Body Weight history with the change since the previous measurement.
+var ExampleWeightTrend = vgi.CatalogExample{
+	Description: "Track one patient's body-weight trend: join their Body Weight Observations (LOINC 29463-7) " +
+		"to fhir_patients on the subject reference to label each row with the patient's name, " +
+		"and compute the change in kg since the previous measurement.",
+	SQL: "SELECT p.given, p.family, o.effective[:10] AS measured_on, round(o.value, 1) AS weight_kg, " +
+		"round(o.value - lag(o.value) OVER (ORDER BY o.effective), 1) AS change_kg " +
+		"FROM fhir.main.fhir_observations('" + ExampleBaseURL + "', query := 'patient=" + ExamplePatientID + "&code=29463-7') AS o " +
+		"JOIN fhir.main.fhir_patients('" + ExampleBaseURL + "', query := '_id=" + ExamplePatientID + "') AS p " +
+		"ON o.subject = 'Patient/' || p.id " +
+		"ORDER BY o.effective;",
+}
+
+// ExampleProblemList joins fhir_search('Condition') to fhir_patients: one
+// patient's problem list with clinical status and age at onset.
+var ExampleProblemList = vgi.CatalogExample{
+	Description: "Build one patient's problem list: search their Condition resources with fhir_search, " +
+		"join to fhir_patients on the subject reference, and report each condition's clinical status, " +
+		"onset date, and the patient's age in whole years at onset.",
+	SQL: "SELECT p.given, p.family, " +
+		"json_extract_string(c.resource, '$.code.text') AS condition_name, " +
+		"json_extract_string(c.resource, '$.clinicalStatus.coding[0].code') AS clinical_status, " +
+		"CAST(json_extract_string(c.resource, '$.onsetDateTime')[:10] AS DATE) AS onset_date, " +
+		"date_sub('year', CAST(p.birth_date AS DATE), onset_date) AS age_at_onset " +
+		"FROM fhir.main.fhir_search('" + ExampleBaseURL + "', 'Condition', query := 'patient=" + ExamplePatientID + "') AS c " +
+		"JOIN fhir.main.fhir_patients('" + ExampleBaseURL + "', query := '_id=" + ExamplePatientID + "') AS p " +
+		"ON json_extract_string(c.resource, '$.subject.reference') = 'Patient/' || p.id " +
+		"ORDER BY onset_date, condition_name;",
+}
+
+// ExampleLatestVitals joins a fhir_read Patient to its fhir_observations and
+// aggregates: the most recent numeric vital-sign value per code.
+var ExampleLatestVitals = vgi.CatalogExample{
+	Description: "Summarise one patient's latest vital signs: read the Patient by id with fhir_read for a display name, " +
+		"join it to their vital-signs Observations, and keep the most recent numeric value and unit per vital sign " +
+		"(components-only vitals such as Blood Pressure have a NULL value and drop out).",
+	SQL: "WITH pt AS (SELECT json_extract_string(resource, '$.id') AS patient_id, " +
+		"json_extract_string(resource, '$.name[0].given[0]') || ' ' || json_extract_string(resource, '$.name[0].family') AS patient_name " +
+		"FROM fhir.main.fhir_read('" + ExampleBaseURL + "', 'Patient', '" + ExamplePatientID + "')) " +
+		"SELECT pt.patient_name, o.code_display, round(arg_max(o.value, o.effective), 1) AS latest_value, " +
+		"arg_max(o.unit, o.effective) AS unit, max(o.effective)[:10] AS latest_on " +
+		"FROM fhir.main.fhir_observations('" + ExampleBaseURL + "', query := 'patient=" + ExamplePatientID + "&category=vital-signs') AS o " +
+		"JOIN pt ON o.subject = 'Patient/' || pt.patient_id " +
+		"WHERE o.value IS NOT NULL " +
+		"GROUP BY pt.patient_name, o.code_display " +
+		"ORDER BY o.code_display;",
+}
+
+// ComposedExamples lists every composed example, in the order the schema-level
+// vgi.example_queries list shows them.
+var ComposedExamples = []vgi.CatalogExample{ExampleWeightTrend, ExampleProblemList, ExampleLatestVitals}
+
+// exampleQuery is the described {description, sql} shape of a
+// vgi.example_queries entry (VGI515).
+type exampleQuery struct {
+	Description string `json:"description"`
+	SQL         string `json:"sql"`
+}
+
+// ExampleQueriesJSON renders examples as the described [{description,sql}] JSON
+// list carried by the vgi.example_queries tag, so a tag is always generated from
+// the same Examples slice the function advertises natively. HTML escaping is off
+// so query strings like `a=1&b=2` stay readable.
+func ExampleQueriesJSON(examples []vgi.CatalogExample) string {
+	list := make([]exampleQuery, len(examples))
+	for i, e := range examples {
+		list[i] = exampleQuery{Description: e.Description, SQL: e.SQL}
+	}
+	var buf bytes.Buffer
+	enc := json.NewEncoder(&buf)
+	enc.SetEscapeHTML(false)
+	if err := enc.Encode(list); err != nil {
+		// Only strings are encoded, so this cannot fail.
+		panic(err)
+	}
+	return string(bytes.TrimRight(buf.Bytes(), "\n"))
+}
+
+// searchExamples are fhir_search's examples, also rendered into its
+// vgi.example_queries tag. The vgi-lint agent simulator shows only the first 5,
+// so a composed example driven by this function must stay within them.
+var searchExamples = []vgi.CatalogExample{
+	{
+		SQL:         "SELECT id FROM fhir.main.fhir_search('https://r4.smarthealthit.org', 'Condition') LIMIT 20;",
+		Description: "List the ids of all Condition resources on a FHIR R4 server (paging through Bundle next links).",
+	},
+	{
+		SQL:         "SELECT id, resource FROM fhir.main.fhir_search('https://hapi.fhir.org/baseR4', 'Patient', query := 'name=smith', count := 100);",
+		Description: "Search Patients named 'smith' on the public HAPI R4 server, 100 per page, returning id plus the raw resource JSON.",
+	},
+	ExampleProblemList,
+}
+
+// readExamples are fhir_read's examples, also rendered into its
+// vgi.example_queries tag. The vgi-lint agent simulator shows only the first 5,
+// so a composed example driven by this function must stay within them.
+var readExamples = []vgi.CatalogExample{
+	{
+		SQL:         "SELECT resource FROM fhir.main.fhir_read('https://r4.smarthealthit.org', 'Patient', '45a69bf0-7116-4f9f-a1d9-29700439b4a4');",
+		Description: "Read one Patient by its logical id on the SMART Health IT R4 sandbox and return its full JSON.",
+	},
+	ExampleLatestVitals,
+}
+
+// patientsExamples are fhir_patients's examples, also rendered into its
+// vgi.example_queries tag. The vgi-lint agent simulator shows only the first 5,
+// so a composed example driven by this function must stay within them.
+var patientsExamples = []vgi.CatalogExample{
+	{
+		SQL:         "SELECT id, family, given, gender, birth_date FROM fhir.main.fhir_patients('https://r4.smarthealthit.org') LIMIT 20;",
+		Description: "List Patients with their core demographic fields flattened into columns.",
+	},
+	{
+		SQL:         "SELECT id, family, given, birth_date FROM fhir.main.fhir_patients('https://hapi.fhir.org/baseR4', query := 'family=Smith') LIMIT 20;",
+		Description: "List Patients with family name Smith on the public HAPI R4 server.",
+	},
+}
+
+// observationsExamples are fhir_observations's examples, also rendered into its
+// vgi.example_queries tag. The vgi-lint agent simulator shows only the first 5,
+// so a composed example driven by this function must stay within them.
+var observationsExamples = []vgi.CatalogExample{
+	{
+		SQL:         "SELECT code, code_display, value, unit FROM fhir.main.fhir_observations('https://r4.smarthealthit.org') WHERE value IS NOT NULL LIMIT 20;",
+		Description: "List numeric Observations with their code, value, and unit.",
+	},
+	{
+		SQL:         "SELECT id, value, unit, effective FROM fhir.main.fhir_observations('https://hapi.fhir.org/baseR4', query := 'code=29463-7') LIMIT 20;",
+		Description: "List body-weight Observations (LOINC 29463-7) on the public HAPI R4 server with their value, unit, and effective time.",
+	},
+	ExampleWeightTrend,
+}
+
+// capabilitiesExamples are fhir_capabilities's examples, also rendered into its
+// vgi.example_queries tag. The vgi-lint agent simulator shows only the first 5,
+// so a composed example driven by this function must stay within them.
+var capabilitiesExamples = []vgi.CatalogExample{
+	{
+		SQL:         "SELECT resource_type, interactions FROM fhir.main.fhir_capabilities('https://hapi.fhir.org/baseR4');",
+		Description: "List every resource type a FHIR server supports and the REST interactions available for each.",
+	},
+	{
+		SQL:         "SELECT resource_type, UNNEST(interactions) AS interaction FROM fhir.main.fhir_capabilities('https://r4.smarthealthit.org');",
+		Description: "Expand the supported REST interactions to one row per (resource type, interaction).",
+	},
+}
